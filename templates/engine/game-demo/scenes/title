#!/usr/bin/env bash

#TODO: docs
# Example scene for title screen
# Used by default if __gs_GAME_title is not defined

#TODO: Remove this when done w dev
unset -f __gs_tictactoe_title

if ! declare -f __gs_{{ game.cmd_name }}_title &>/dev/null; then
  __gs_{{ game.cmd_name }}_title() {
    local action="$1"
    __gs_required_args action || return 2
    case _${action}_ in
      _open_)
        __gs_scene_manager push title
        __gs_button_manager init title

        local gameTitleOffset=$(( GS_Y_END / 6 ))
        __gs_node init anim game-title -x c -y "c-$gameTitleOffset" -s "animations/title/title"

        local firstBtnOffset=$(( GS_Y_END / 5 ))
        __gs_button_manager add-buttons title \
          Play:play:c:c+$firstBtnOffset \
          Quit:quit:c:c+$firstBtnOffset+4 || {
          __gs_errormsg "Could not init button manager"
          return 1
        }

        __gs_button_manager subscribe-defaults title
        __gs_event subscribe title quit '{ export GS_EXIT=true; }'
        __gs_event subscribe title pause '__gs_{{ game.cmd_name }}_pause open'

        local name="{{ game.cmd_name }}"
        local verVar="GS_${name^^}_VER"
        local version="${!verVar:-$GS_SERVER_VER}"
        GS_TITLE_VERSTR="$name v$version"
      ;;
      _render_)
        __gs_frame baseframe title || return 1
        __gs_frame draw game-title || return 1
        __gs_text $GS_X_START $(( GS_Y_END - 1 )) "$GS_TITLE_VERSTR" || return 1
        __gs_button_manager render title || return 1
      ;;
      #TODO: create button manager with play/settings/quit
      #TODO: quit button should run close which also kills the game
      _close_)
        unset GS_TITLE_VERSTR
        __gs_button_manager destroy title || return 1
      ;&
      *) __gs_scene "$@" title || return 1 ;;
    esac
  }
fi

