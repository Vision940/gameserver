#!/usr/bin/env bash

## templates/client/completion ##
## Dynamically generated bash script with default completion method for nested case functions
## Case options that use this syntax are supported (any # of spaces is fine):
## case _$1_ in
##   _option_) : Short description
##     case _$1_$2_ in
##       _option_suboption_) : Capability here
##         :
##       ;;
##     esac
##   ;;
## esac
##
## The : <desc> part of the case option is used to generate descriptions in the completion opts
##
## Specific function handling can be added for a cmd with a specialized fxn included at render time
##   using the __gs_<cmd>_comp function naming convention
##
## __gs_call_subcompletion below allows completing using a sub-completion function that could also
##   be generated from this template
## for instance, if the case OPT1 in the main completed function calls another function requiring
##   its own completion, then `__gs_call_subcompletion CMD OPT1 COMPFXN` could be called to
##   complete with COMPFXN using the current line
## for an example usage of this in a custom command completion function, see __gs_game_comp below
##
## This template gets generated by called route - templates/<cmd>-completion
##
## Author: Daniel Tucker <github.com/Vision940>
##

_{{ game }}() {
  declare -f {{ game }} &>/dev/null || return

  local completions

  # Call command specific method if it exists
  if declare -f "__gs_{{ game }}_comp" &>/dev/null; then
    __gs_{{ game }}_comp "$1" "$2" "$3" && return 0
  fi

  local completions=()
  if (( COMP_CWORD == 1 )); then
    # Get options (and descriptions if available)
    mapfile -t completions < <(declare -f {{ game }} | sed -ne '/^\s.*)$/,+1 { /)$/N;s/\s*_\(.*\)_)\(\n\s\+ : \(.*\);\)\{0,1\}.*/\1\t\3/p; }' | grep -v [*_] | sed -e 's/\t$//g')
  elif (( COMP_CWORD == 2 )); then
    # Get suboptions (and descriptions if available)
    mapfile -t completions < <(declare -f {{ game }} | sed -ne "\|^\\s*_.*$3_.*_)$|,+1 { /)$/N;s|\\s*_$3"'_\(.*\)_)\(\n\s\+ : \(.*\);\)\{0,1\}.*|\1\t\3|p; }' | grep -v [*_] | sed -e 's/\t$//g')
  fi

  __gs_comp_resp "$2" "${completions[@]}"
}
complete -F _{{ game }} {{ game }}

{# Jinja thinks "{#" is a comment so need raw #}
{% raw %}
# Inspired by cobra completion used in tailscale
__gs_comp_resp() {
  local cur="$1"
  shift

  local tab=$'\t'
  local completions=("$@")
  COMPREPLY=()

  # If no tabs, just respond with words
  if [[ "${completions[*]}" != *$tab* ]]; then
    COMPREPLY=( $(compgen -W "${completions[*]}" -- "$cur") )
    return 0
  fi

  # Filter comp options from cur
  local comp desc longest=0 line
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    comp="${line%%$tab*}"

    [[ "$comp" == "$cur"* ]] || continue

    COMPREPLY+=("$line")

    if (( ${#comp} > longest )); then
      longest=${#comp}
    fi
  done < <(printf '%s\n' "${completions[@]}")

  # Either respond with last option or provide descriptions
  if (( ${#COMPREPLY[@]} == 1 )); then
    COMPREPLY[0]="${COMPREPLY[0]%%$tab*}"
  else
    __gs_fmt_comp_desc "$longest"
  fi
}
{% endraw %}


{% raw %}
__gs_fmt_comp_desc() {
  local tab=$'\t'
  local longest="$1"
  local comp desc maxdesclength i cidx

  # Try extra hard to get COLUMNS
  shopt -s checkwinsize
  (:) # this ensures LINES and COLUMNS are set
  [[ -z $COLUMNS ]] && COLUMNS=$(tput cols)

  for cidx in "${!COMPREPLY[@]}"; do
    comp="${COMPREPLY[$cidx]}"

    if [[ "$comp" == *$tab* ]]; then
      desc="${comp#*$tab}"
      comp="${comp%%$tab*}"

      maxdesclength=$(( COLUMNS - longest - 4 ))

      # Space out descriptions appropriately
      if (( maxdesclength > 8 )); then
        for (( i=${#comp}; i<longest; i++ )); do
          comp+=" "
        done
      else
        maxdesclength=$(( COLUMNS - ${#comp} - 4 ))
      fi

      # Build description strings
      if (( maxdesclength > 0 )) && [[ -n "$desc" ]]; then
        if (( ${#desc} > maxdesclength )); then
          desc="${desc:0:$((maxdesclength - 1))}…"
        fi
        comp+="  ($desc)"
      fi

      COMPREPLY[$cidx]="$comp"
    fi
  done
}
{% endraw %}

{% raw %}
__gs_call_subcompletion() {
  local caller="$1"
  local called="$2"
  local function="$3"

  local curline="${COMP_LINE:0:$COMP_POINT}" # save current line up to cursor
  curline="${curline#$caller}"
  curline="${curline# }"

  local cur="${curline##* }" # save current word
  local prev="${curline% *}"
  [[ "$prev" =~ " " ]] && prev="${prev##* }" # save previous word

  # Use function completion to complete for us
  COMP_WORDS=($(echo "$curline"))
  [[ -z "$cur" ]] && COMP_WORDS+=('')
  COMP_LINE="$curline"
  COMP_CWORD=$(( ${#COMP_WORDS[@]} - 1 ))
  COMP_POINT=${#COMP_LINE}
  $function $called ${cur:-''} ${prev:-''} 2>/dev/null
}
{% endraw %}

# Responds with available games when completing load option
__gs_game_comp() {
  if (( COMP_CWORD >= 2 )); then
    case "${COMP_WORDS[1]}" in
      load)
        (( COMP_CWORD > 2 )) && return
        COMPREPLY=($(compgen -W "{{ game_list | join(' ') }}" -- ${2}))
      ;;
      admin)
        __gs_call_subcompletion game admin ___gs_admin
      ;;
    esac
    return 0
  fi
  return 1
}

