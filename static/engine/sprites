#!/usr/bin/env bash

#TODO: docs
# __gs_text draws text over drawn sprites at given location
# __gs_sprite_parser parses spr and rawspr formats and reads cell values from strings of cell data (from rawspr usually)
# __gs_sprite manages caching, setup, cleanup, next-frame processing
# drawing moved to gs_frame
# note that find-file prefers spr so if looking for rawspr ensure suffix is there

__gs_sprite() {
  local action="$1"

  case _${action}_ in
    _cache_)
      local file
      while read -r file; do
        if [[ "$file" =~ ".rawspr"$ ]]; then
          __gs_sprite_parser parse-rawspr "$file" || return 1
        else
          __gs_sprite_parser parse-spr "$file" || return 1
        fi
      done < <(find ${GS_CACHE}/sprites -regex '.*\.\(raw\)\{0,1\}spr')
    ;;
    _cleanup_) __gs_unset_vars_from_prefixes GSS_ ;;
    _exists_)
      local file="$2"

      # Find file based on input
      $FUNCNAME find-file "$file"
      file="$REPLY"

      # Return appropriate id
      $FUNCNAME id-from-file "$file"
      local sprId="$REPLY"

      [[ " ${GSS_RAWSPRS[@]} ${GSS_SPRS[@]} " =~ " $sprId " ]] || {
        __gs_errormsg "Sprite id \"$sprId\" calculated in $FUNCNAME exists is not cached"
        return 1
      }

      REPLY="$sprId"
      return 0
    ;;
    _find-file_)
      local file="$2"
      if [[ ! -f "$file" ]]; then
        [[ -f "$file.spr" ]] && file="$file.spr"
        [[ -f "$file.rawspr" ]] && file="$file.rawspr"
        [[ -f "${GS_CACHE}/sprites/$file.spr" ]] && file="${GS_CACHE}/sprites/$file.spr"
        [[ -f "${GS_CACHE}/sprites/$file.rawspr" ]] && file="${GS_CACHE}/sprites/$file.rawspr"
        [[ -f "${GS_CACHE}/sprites/$file" ]] && file="${GS_CACHE}/sprites/$file"
      fi
      REPLY="$file"
    ;;
    _id-from-file_)
      local file="$2"

      local sprId="${file//\//_}"
      sprId="${sprId#*_sprites_}"
      sprId="${sprId//[- \'\"]/_}"
      sprId="${sprId%.spr}"
      [[ "$sprId" =~ ".rawspr"$ ]] && {
        sprId="${sprId%.rawspr}"
        sprId+="_RAW"
      }
      sprId="${sprId#_}"
      REPLY="${sprId^^}"
    ;;
    _max-height_)
      local sprId="$2"
      if [[ " ${GSS_SPRS[@]} " =~ " $sprId " ]]; then
        REPLY="${GSS_FRAMES["${sprId}:max_height"]}"
      else
        # Assuming rawspr
        REPLY="${GSS_ROWS["$sprId"]}"
      fi
    ;;
    _max-width_)
      local sprId="$2"
      if [[ " ${GSS_SPRS[@]} " =~ " $sprId " ]]; then
        REPLY="${GSS_FRAMES["${sprId}:max_width"]}"
      else
        # Assuming rawspr
        REPLY="${GSS_WIDTH["$sprId"]}"
      fi
    ;;
    _next-frame_)
      local id="$2"
      local state frame
      IFS=: read -r state frame <<<"${GSN_STATE[$id]:-default}"
      frame="${frame:--1}"
      [[ "$frame" == "hide" ]] && frame=-1 # Should only be here if visible

      local sprId="${GSN_SPRITE["$id"]}"
      local frames=(${GSS_FRAMES["${sprId}:${state}:frames"]% })
      local num_frames=${#frames[@]}
      (( num_frames == 0 )) && {
        __gs_errormsg "No frames in drawn sprite $id"
        return 1
      }

      local new_frame
      if (( frame + 1 >= num_frames )); then
        # Handle end of animation based on sprite options
        if __gs_sprite_config "${sprId}" "${state}" loop true; then
          # If looped, then loop
          new_frame=0
        else
          if __gs_sprite_config "${sprId}" "${state}" next-state null; then
            # No next state specified
            if __gs_sprite_config "${sprId}" "${state}" hide true; then
              # Sprite set to hide after anim finished
              new_frame=hide
              GSN_VISIBLE["$id"]=
            else
              # Stay on last frame
              new_frame=$frame
            fi
          else
            # Go to frame 0 of next state
            state=$REPLY
            frames=(${GSS_FRAMES["${sprId}:${state}:frames"]% })
            num_frames=${#frames[@]}
            (( num_frames == 0 )) && {
              __gs_errormsg "No frames in next state $state"
              return 1
            }
            new_frame=0
          fi
        fi
      else
        # Increment current animation
        new_frame=$((frame+1))
      fi

      [[ "$new_frame" == "$frame" ]] || GS_PENDING_ANIMS=true
      GSN_STATE["$id"]="$state:$new_frame"
      __gs_debugmsg "Set GSN_STATE to \"$state:$new_frame\" for $id" 4

      REPLY=
      [[ "$new_frame" =~ ^[0-9]+$ ]] && REPLY="${frames[$new_frame]}"

      return 0
    ;;
    _setup_)
      [[ ${GSS_SETUP:-false} == true ]] && return 0

      declare -gA GSS_CELL=()
      declare -gA GSS_ROWS=()
      declare -gA GSS_COLS=()
      declare -gA GSS_WIDTH=()
      declare -ga GSS_RAWSPRS=()
      declare -ga GSS_SPRS=()
      declare -gA GSS_FRAMES=()

      GSS_SETUP=true
    ;;
  esac
}

# Check config value for sprite with fallbacks
__gs_sprite_config() {
  local id="$1" state="$2" param="$3" expected="$4"
  local result="${GSS_FRAMES["${id}:${state}:${param}"]:-null}"
  [[ "$result" == "null" ]] && local result="${GSS_FRAMES["${id}:default:${param}"]:-null}"
  __gs_debugmsg "Sprite config [${id}:${state}:${param}]=${GSS_FRAMES["${id}:${state}:${param}"]:-null}" 5

  REPLY="$result"
  [[ "$result" == "$expected" ]]
}

# Mostly a separate function just bc it's clunky
__gs_sprite_parser() {
  local action="$1"

  case _${action}_ in
    _get-cell_)
      local __varname="$2"
      local row="${!__varname}"
      local esc=$'\e'
      local reset=$'\e[0m'
      local prefix= suffix= glyph code

      REPLY=
      [[ -n "$row" ]] || return 1

      # Optional ANSI prefix
      while [[ "$row" == "$esc["* ]]; do
        code="${row%%m*}"
        [[ "$code" != "$row" ]] || break
        code+="m"
        prefix+="$code"
        row="${row#"$code"}"
      done

      [[ -n "$row" ]] || return 1

      # One visible glyph
      glyph="${row:0:1}"
      row="${row:1}"

      # Optional trailing reset
      if [[ "$row" == "$reset"* ]]; then
        suffix="$reset"
        row="${row#"$reset"}"
      fi

      REPLY="${prefix}${glyph}${suffix}"
      if [[ -n "$prefix" && -z "$suffix" && -n "$row" ]]; then
        row="${prefix}${row}"
      fi
      printf -v "$__varname" '%s' "$row"
    ;;
    _parse-spr_)
      local file="$2"

      [[ "$file" =~ ".spr"$ ]] || {
        __gs_errormsg "Sprite file \"$file\" to parse-spr is not a .spr file"
        return 1
      }
      [[ -f "$file" ]] || {
        __gs_errormsg "Sprite file \"$file\" not found in file cache"
        return 1
      }

      __gs_sprite id-from-file "$file"
      local sprId="$REPLY"
      [[ " ${GSS_SPRS[@]} " =~ " $sprId " ]] && return 0
      __gs_debugmsg "Caching sprite file \"$file\"" 3

      local text param val
      local state="default" # This is ${GSN_STATE[$id]%:*}
      local states=($state)
      while IFS= read -r text; do
        text="${text%%#*}"
        text="${text%%[$'\t\r\n ']}"

        if [[ "$text" =~ ^\[(.+)\]$ ]]; then
          state="${BASH_REMATCH[1]}"
          [[ " ${states[@]} " =~ " $state " ]] || states+=($state)
        elif [[ "$text" =~ ^([^=]+)=(.*)$ ]]; then
          param="${BASH_REMATCH[1]}"
          val="${BASH_REMATCH[2]}"
          GSS_FRAMES["${sprId}:${state}:${param}"]="$val"
        elif [[ -n "$text" ]]; then
          [[ ! "$text" =~ ".rawspr"$ ]] && text+=".rawspr"
          __gs_sprite id-from-file "$text"
          local rawsprId="$REPLY"
          __gs_sprite find-file "$text"
          local rawsprfile="$REPLY"

          if [[ ! " ${GSS_RAWSPRS[@]} " =~ " $rawsprId " ]]; then
            $FUNCNAME parse-rawspr "$rawsprfile" || return 1
          fi
          GSS_FRAMES["${sprId}:${state}:frames"]+="$rawsprId "
        fi
      done < "$file"

      local w=0 h=0
      local frames=(${GSS_FRAMES["${sprId}:${state}:frames"]% })
      for state in ${states[@]}; do
        for frame in ${frames[@]}; do
          local gss_w="${GSS_WIDTH[$frame]}" gss_h="${GSS_ROWS[$frame]}"
          (( gss_w > w )) && w=$gss_w
          (( gss_h > h )) && h=$gss_h
        done
      done

      GSS_FRAMES["${sprId}:max_width"]=$w
      GSS_FRAMES["${sprId}:max_height"]=$h

      GSS_SPRS+=("$sprId")
    ;;
    _parse-rawspr_)
      local rawfile="$2"

      [[ "$rawfile" =~ ".rawspr"$ ]] || {
        __gs_errormsg "Sprite file \"$rawfile\" to parse-rawspr is not a .rawspr file"
        return 1
      }
      [[ -f "$rawfile" ]] || {
        __gs_errormsg "Sprite file \"$rawfile\" not found in file cache"
        __gs_errormsg "Ensure file exists (make sprites?)"
        return 1
      }

      __gs_sprite id-from-file "$rawfile"
      local sprId="$REPLY"
      [[ " ${GSS_RAWSPRS[@]} " =~ " $sprId " ]] && return 0
      __gs_debugmsg "Caching raw sprite file \"$rawfile\"" 3

      local text row=0 col maxw=0
      while IFS= read -r text; do
        col=0
        while $FUNCNAME get-cell text; do
          GSS_CELL["$sprId:$row:$col"]=$REPLY
          ((col++))
        done
        GSS_COLS["$sprId:$row"]=$col
        (( col > maxw )) && maxw=$col
        ((row++))
      done < "$rawfile"

      GSS_ROWS["$sprId"]=$row
      GSS_WIDTH["$sprId"]=$maxw
      GSS_RAWSPRS+=("$sprId")
    ;;
  esac
}

# Defaults to Tango Light/Dark text colors
export GS_DEFAULT_TEXT_LIGHT="211;215;207"
export GS_DEFAULT_TEXT_DARK="46;52;54"
__gs_text() {
  local darkVar="GS_${GS_GAME:-DEFAULT}_TEXT_DARK"
  local dark="${!darkVar:-$GS_DEFAULT_TEXT_DARK}"

  local lightVar="GS_${GS_GAME:-DEFAULT}_TEXT_LIGHT"
  local light="${!lightVar:-$GS_DEFAULT_TEXT_LIGHT}"

  local opt OPTIND OPTARG
  while getopts 'dl' opt; do
    case "$opt" in
      d) [[ "$OPTARG" =~ ^[0-9]+";"[0-9]+";"[0-9]$ ]] &&  dark="$OPTARG" ;;
      l) [[ "$OPTARG" =~ ^[0-9]+";"[0-9]+";"[0-9]$ ]] && light="$OPTARG" ;;
    esac
  done
  shift $(( OPTIND - 1 ))

  local x="$1" y="$2" text="$3"
  local reset=$'\x1b[0m'
  local ansi=""

  local char currCell idx pos prevCell
  local r g b bg lum thresh fg
  for (( idx=0; idx<${#text}; idx++ )); do
    char="${text:idx:1}"
    pos=$((y * COLUMNS + x + idx))
    currCell="${GS_FRAME_CELLS["$pos"]}"

    # Determine text color (light vs. dark) smartly from target cell
    if [[ "$currCell" != "$prevCell" && "$currCell" =~ $'\e'\[48\;2\;([0-9]+)\;([0-9]+)\;([0-9]+)m ]]; then
      bg="${BASH_REMATCH[0]}"
      r=${BASH_REMATCH[1]}
      g=${BASH_REMATCH[2]}
      b=${BASH_REMATCH[3]}

      # Perceived luminence based on sRGB / Rec. 709 coefficients
      #   but with approximation gamma=2 for simplicity of calculation
      # Coefficients are *10k and each color value is squared
      lum=$(( 2126*r*r + 7152*g*g + 722*b*b ))
      # W3C Contrast Ratio formula:
      # (L1 + .05) / (L2 + .05)
      # With L as luminance of the color, 0 for black, 1 for white,
      #   when the below is true, text should be dark:
      #   (L + 0.05) / (0.0 + 0.05) > (1.0 + 0.05) / (L + 0.05)
      # This simplifies to text black when L > .179
      # Max luminence = (.2126+.7152+.0722)*10k*255^2
      thresh=116394750 # max * .179

      fg=$'\e[38;2;'
      if (( lum > thresh )); then
        fg+="${dark}m"
      else
        fg+="${light}m"
      fi
      ansi="${bg}${fg}"
      prevCell="$currCell"
    fi

    GS_FRAME_CELLS[$pos]="${ansi}$char"
    (( idx == ${#text}-1 )) && GS_FRAME_CELLS[$pos]+="${reset}"
  done

  return 0
}

