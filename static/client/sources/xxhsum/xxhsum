    (( h64 *= PRIME64_2 ))
    (( h64 ^= ((h64>>(29))&(~(((1<<63)>>(29))<<1))) ))
    (( h64 *= PRIME64_3 ))
    (( h64 ^= ((h64>>(32))&(~(((1<<63)>>(32))<<1))) ))

    printf "%016x" $h64
}

# uint32_t XXH32(data, seed = 0)
__gs_xxh32()
{
    # Performance is multiplied by eightfold if we switch to C locale.
    local LC_ALL="C"

    local -i PRIME32_1=2654435761
    local -i PRIME32_2=2246822519
    local -i PRIME32_3=3266489917
    local -i PRIME32_4=668265263
    local -i PRIME32_5=374761393

    local -i seed=${2:-0}
    local -i tmp=0
    local -i zero=0
    local -i h32=0
    local input="$1"
    local -i len=$(( ${#input} / 2 ))
    local -i remaining=$len
    local -i offset=0
    local -i bEnd=$(( ${#input} - 32 ))
    if (( remaining >= 16 )); then
        local -i v1=$(( ( ( (seed + PRIME32_1) & 0xFFFFFFFF) + PRIME32_2) & 0xFFFFFFFF ))
        local -i v2=$(( (seed + PRIME32_2) & 0xFFFFFFFF ))
        local -i v3=$(( seed ))
        local -i v4=$(( (seed - PRIME32_1) & 0xFFFFFFFF ))

        while (( offset <= bEnd )); do
            local inp="${input:$offset:32}"
            v1=$((((v1+(($(( \
( ( (tmp=0x${inp:0:8}) << 24) & 0xff000000 ) | \
            ( (tmp <<  8) & 0x00ff0000 ) | \
            ( (((tmp>>(8))&(~(((1<<63)>>(8))<<1)))) & 0x0000ff00 ) | \
            ( (((tmp>>(24))&(~(((1<<63)>>(24))<<1)))) & 0x000000ff ) \
   )) \
*PRIME32_2) & 0xFFFFFFFF)) & 0xFFFFFFFF) ));
    v1=$(( ((((((v1)<<(13))|((v1>>(32-13)))))&0xFFFFFFFF&0xFFFFFFFF)*PRIME32_1) & 0xFFFFFFFF ))

            v2=$((((v2+(($(( \
( ( (tmp=0x${inp:8:8}) << 24) & 0xff000000 ) | \
            ( (tmp <<  8) & 0x00ff0000 ) | \
            ( (((tmp>>(8))&(~(((1<<63)>>(8))<<1)))) & 0x0000ff00 ) | \
            ( (((tmp>>(24))&(~(((1<<63)>>(24))<<1)))) & 0x000000ff ) \
   )) \
*PRIME32_2) & 0xFFFFFFFF)) & 0xFFFFFFFF) ));
    v2=$(( ((((((v2)<<(13))|((v2>>(32-13)))))&0xFFFFFFFF&0xFFFFFFFF)*PRIME32_1) & 0xFFFFFFFF ))

            v3=$((((v3+(($(( \
( ( (tmp=0x${inp:16:8}) << 24) & 0xff000000 ) | \
            ( (tmp <<  8) & 0x00ff0000 ) | \
            ( (((tmp>>(8))&(~(((1<<63)>>(8))<<1)))) & 0x0000ff00 ) | \
            ( (((tmp>>(24))&(~(((1<<63)>>(24))<<1)))) & 0x000000ff ) \
   )) \
*PRIME32_2) & 0xFFFFFFFF)) & 0xFFFFFFFF) ));
    v3=$(( ((((((v3)<<(13))|((v3>>(32-13)))))&0xFFFFFFFF&0xFFFFFFFF)*PRIME32_1) & 0xFFFFFFFF ))

            v4=$((((v4+(($(( \
( ( (tmp=0x${inp:24:8}) << 24) & 0xff000000 ) | \
            ( (tmp <<  8) & 0x00ff0000 ) | \
            ( (((tmp>>(8))&(~(((1<<63)>>(8))<<1)))) & 0x0000ff00 ) | \
            ( (((tmp>>(24))&(~(((1<<63)>>(24))<<1)))) & 0x000000ff ) \
   )) \
*PRIME32_2) & 0xFFFFFFFF)) & 0xFFFFFFFF) ));
    v4=$(( ((((((v4)<<(13))|((v4>>(32-13)))))&0xFFFFFFFF&0xFFFFFFFF)*PRIME32_1) & 0xFFFFFFFF ))

            ((offset+=32))
        done

        h32=$(( ((((v1)<<(1))|((v1>>(32-1)))))&0xFFFFFFFF & 0xFFFFFFFF ))
        h32=$(( (h32 + (((((v2)<<(7))|((v2>>(32-7)))))&0xFFFFFFFF ))  & 0xFFFFFFFF ))
        h32=$(( (h32 + (((((v3)<<(12))|((v3>>(32-12)))))&0xFFFFFFFF )) & 0xFFFFFFFF ))
        h32=$(( (h32 + (((((v4)<<(18))|((v4>>(32-18)))))&0xFFFFFFFF )) & 0xFFFFFFFF ))
    else
        h32=$(( (seed + PRIME32_5) & 0xFFFFFFFF ));
    fi
    remaining=$(( ${#input} - offset ))
    h32=$(( (h32 + (len & 0xFFFFFFFF))  & 0xFFFFFFFF ))
    while (( remaining >= 8 )); do
        h32=$(( (h32 + ( ( $(( \
( ( (tmp=0x${input:$offset:8}) << 24) & 0xff000000 ) | \
            ( (tmp <<  8) & 0x00ff0000 ) | \
            ( (((tmp>>(8))&(~(((1<<63)>>(8))<<1)))) & 0x0000ff00 ) | \
            ( (((tmp>>(24))&(~(((1<<63)>>(24))<<1)))) & 0x000000ff ) \
   )) \
 * PRIME32_3) & 0xFFFFFFFF)) & 0xFFFFFFFF ))
        (( offset += 8 ))
        h32=$(( ((((((h32)<<(17))|((h32>>(32-17)))))&0xFFFFFFFF & 0xFFFFFFFF) * PRIME32_4) & 0xFFFFFFFF ))
        ((remaining-=8))
    done

    while (( remaining > 0 )); do
        h32=$(( (h32 + ( (0x${input:$offset:2} * PRIME32_5) & 0xFFFFFFFF) ) & 0xFFFFFFFF))
        (( offset += 2 ))
        h32=$(( ((((((h32)<<(11))|((h32>>(32-11)))))&0xFFFFFFFF & 0xFFFFFFFF) * PRIME32_1) & 0xFFFFFFFF ))
        ((remaining-=2))
    done
    h32=$(( (h32 ^ (((h32>>(15))&(~(((1<<63)>>(15))<<1))) & 0xFFFFFFFF) )& 0xFFFFFFFF ))
    h32=$(( (h32 * PRIME32_2) & 0xFFFFFFFF ))
    h32=$(( (h32 ^ (((h32>>(13))&(~(((1<<63)>>(13))<<1))) & 0xFFFFFFFF) )& 0xFFFFFFFF ))
    h32=$(( (h32 * PRIME32_3) & 0xFFFFFFFF ))
    h32=$(( (h32 ^ (((h32>>(16))&(~(((1<<63)>>(16))<<1))) & 0xFFFFFFFF)) & 0xFFFFFFFF ))

    printf "%08x" $h32
}

