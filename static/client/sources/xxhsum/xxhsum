        (( offset += 16 ))
        h64=$(( h64 ^ k1 ));
        h64=$(( (((h64<<27)|(((h64>>((64-27)))&(~(((1<<63)>>((64-27)))<<1))))) * PRIME64_1) + PRIME64_4 ));
        ((remaining -= 16 ));
