    ((((tmp>>(40))&(~(((1<<63)>>(40))<<1))))&(255<<8))|\
    ((((tmp>>(56))&(~(((1<<63)>>(56))<<1))))&255)\
)) \
)*PRIME64_2)));v4=$((((v4<<31)|((v4>>(33))&0x7fffffff) )*PRIME64_1))
            ((offset+=64))
        done

        h64=$(( (((v1<<1)|(((v1>>((64-1)))&(~(((1<<63)>>((64-1)))<<1)))))) + (((v2<<7)|(((v2>>((64-7)))&(~(((1<<63)>>((64-7)))<<1)))))) + (((v3<<12)|(((v3>>((64-12)))&(~(((1<<63)>>((64-12)))<<1)))))) + (((v4<<18)|(((v4>>((64-18)))&(~(((1<<63)>>((64-18)))<<1)))))) ))

        zero=0
    ((zero+=((v1)*PRIME64_2)));zero=$((((zero<<31)|((zero>>(33))&0x7fffffff) )*PRIME64_1))
    h64=$(( ((h64 ^ zero) * PRIME64_1) + PRIME64_4 ))

