)*PRIME64_2)));v2=$((((v2<<31)|((v2>>(33))&0x7fffffff) )*PRIME64_1))
            ((v3+=(($(( \
    (((tmp=0x${inp:32:16})<<56)&(255<<56))|\
    ((tmp<<40)&(255<<48))|\
    ((tmp<<24)&(255<<40))|\
    ((tmp<<8)&(255<<32))|\
    ((((tmp>>(8))&(~(((1<<63)>>(8))<<1))))&(255<<24))|\
    ((((tmp>>(24))&(~(((1<<63)>>(24))<<1))))&(255<<16))|\
    ((((tmp>>(40))&(~(((1<<63)>>(40))<<1))))&(255<<8))|\
    ((((tmp>>(56))&(~(((1<<63)>>(56))<<1))))&255)\
)) \
)*PRIME64_2)));v3=$((((v3<<31)|((v3>>(33))&0x7fffffff) )*PRIME64_1))
            ((v4+=(($(( \
    (((tmp=0x${inp:48:16})<<56)&(255<<56))|\
    ((tmp<<40)&(255<<48))|\
    ((tmp<<24)&(255<<40))|\
    ((tmp<<8)&(255<<32))|\
    ((((tmp>>(8))&(~(((1<<63)>>(8))<<1))))&(255<<24))|\
