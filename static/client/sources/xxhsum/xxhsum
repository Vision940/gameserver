        local -i v2=$(( seed + PRIME64_2 ))
        local -i v3=$(( seed ))
        local -i v4=$(( seed - PRIME64_1 ))

              while (( offset <= bEnd )); do
            inp="${input:$offset:64}"
            ((v1+=(($(( \
    (((tmp=0x${inp:0:16})<<56)&(255<<56))|\
    ((tmp<<40)&(255<<48))|\
    ((tmp<<24)&(255<<40))|\
    ((tmp<<8)&(255<<32))|\
