    if (( remaining >= 8 )); then
        (( h64 ^= ($(( \
( ( (tmp=0x00000000${input:$offset:8}) << 24) & 0xff000000 ) | \
            ( (tmp <<  8) & 0x00ff0000 ) | \
            ( (((tmp>>(8))&(~(((1<<63)>>(8))<<1)))) & 0x0000ff00 ) | \
            ( (((tmp>>(24))&(~(((1<<63)>>(24))<<1)))) & 0x000000ff ) \
   )) \
 * PRIME64_1) ))
        (( offset += 8 ))
        h64=$(( (((h64<<23)|(((h64>>((64-23)))&(~(((1<<63)>>((64-23)))<<1))))) * PRIME64_2) + PRIME64_3 ))
