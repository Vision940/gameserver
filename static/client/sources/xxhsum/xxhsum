# Idea of this is to support xxhsum even if it isn't installed
# There will be significant slowdown if it isn't installed and files are large
# This could definitely be better optimized, but it isn't expected to be
#   the primary method of hashing
# It is really here because it is cool, but also as a useful fallback to reduce
#   dependencies

xxhsum() {
  # Runs xxhsum command if available with all args
  # Bash version supports multiple filename args with -H0 or -H1
  # To force bash version, set USE_GS_XXHSUM in env or on call

  [[ -z "$USE_GS_XXHSUM" ]] && command xxhsum --help &>/dev/null && { command xxhsum "$@"; return; }
  declare -f __gs_debugmsg &>/dev/null && __gs_debugmsg "Using bash xxhsum"
  declare -f __gs_warnmsg &>/dev/null || __gs_warnmsg() { echo "WARN: $@"; }

  local algorithm=__gs_xxh64
  if (( $# > 1 )) && [[ "$1" =~ "-H"[01] ]]; then
    case "$1" in
      -H0) algorithm=__gs_xxh32 ;;
      -H1) algorithm=__gs_xxh64 ;;
    esac
    shift
  fi

  ! (($#)) && {
    echo "No input provided " 1>&2
    return 1
  }

  local file
  for file; do
      [[ ! -f "$file" ]] && {
        echo "Error: unable to open input" 1>&2
        echo "Error: Could not open '$file': No such file or directory. " 1>&2
        return 1
      }

      local size
      read -r size _ < <(du -s "$file")
      (( size > 1000000 )) && {
          __gs_warnmsg "File input to bash xxhsum is > 1M"
          __gs_warnmsg "Consider installing xxhsum"
      }

      local DATA="$(hexdump -e '/1 "%02X"' -v -- "$file")"
      printf '%s  %s\n' "$($algorithm "$DATA" 0)" "$file"
  done
}

# uint64_t XXH64(text_in_hex, seed = 0)
